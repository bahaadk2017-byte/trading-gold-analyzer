{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageEvent",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "payload_type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "environment": {
      "enum": [
        "live",
        "demo",
        "simulated",
        "backtest",
        "experimental"
      ]
    }
  },
  "required": [
    "message_id",
    "correlation_id",
    "sender",
    "recipient",
    "timestamp_utc",
    "payload_type",
    "payload",
    "environment"
  ]
}