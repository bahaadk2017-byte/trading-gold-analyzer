{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LearningRecord",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string"
    },
    "strategy_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "changed_by": {
      "type": "string"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "change_reason": {
      "type": "string"
    },
    "environment": {
      "enum": [
        "live",
        "demo",
        "simulated",
        "backtest",
        "experimental"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter": {
            "type": "string"
          },
          "old_value": {},
          "new_value": {}
        },
        "required": [
          "parameter",
          "old_value",
          "new_value"
        ]
      }
    }
  },
  "required": [
    "record_id",
    "strategy_name",
    "version",
    "changed_by",
    "timestamp_utc",
    "change_reason",
    "environment",
    "changes"
  ]
}